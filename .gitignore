/market_data/
# Validation reports are regenerated by `kestrel validate`; the committed
# summary lives in docs/progress.md and reports/summary.json.
/reports/*/

# Research notebooks' scratch output not meant to be committed
.ipynb_checkpoints/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Node (web/ dashboard, Phase 6)
node_modules/
web/dist/

# Deployment secrets (deploy/.env, deploy/ibgateway.env)
deploy/.env
deploy/*.env
!deploy/*.env.example

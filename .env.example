# Copy to .env (gitignored, chmod 600 on the server) and fill in.
# Every variable the app reads goes through config.settings.Settings,
# prefixed KESTREL_ — see that file for defaults. Separate keys per venue
# AND per mode (design rule 9). Never put live keys here before Phase 7
# is explicitly unlocked (SPEC.md Section 0, rule 4).

# --- storage ---
KESTREL_DATA_DIR=market_data
KESTREL_POSTGRES_DSN=postgresql+psycopg://kestrel:kestrel@localhost:5432/kestrel

# --- Binance Spot Testnet (sandbox mode, crypto) ---
# Create at https://testnet.binance.vision (log in with GitHub). Test
# funds only; the testnet is wiped periodically.
KESTREL_BINANCE_TESTNET_API_KEY=
KESTREL_BINANCE_TESTNET_API_SECRET=

# --- Interactive Brokers (sandbox = paper account via IB Gateway) ---
# The engine only connects to the gateway; the IBKR username/password go
# in deploy/.env.ibgateway for the gateway container (IBC), never here.
KESTREL_IBKR_HOST=127.0.0.1
KESTREL_IBKR_PAPER_PORT=4002
KESTREL_IBKR_CLIENT_ID=17
# Optional, only needed if the login sees several accounts. Never commit it.
KESTREL_IBKR_PAPER_ACCOUNT=

# --- Kraken (LIVE crypto; Phase 7 only — leave empty) ---
KESTREL_KRAKEN_API_KEY=
KESTREL_KRAKEN_API_SECRET=
KESTREL_LIVE_TRADING_ENABLED=false

# --- alerts (ntfy) ---
# e.g. http://127.0.0.1:<port of the box's own ntfy>; empty = log-only
KESTREL_NTFY_URL=
KESTREL_NTFY_TOPIC=kestrel
KESTREL_NTFY_TOKEN=

# --- service ports (127.0.0.1 only; ADR 0003) ---
KESTREL_METRICS_PORT=9710
KESTREL_METRICS_ADDR=127.0.0.1

# --- misc ---
KESTREL_LOG_LEVEL=INFO
KESTREL_LOG_JSON=true

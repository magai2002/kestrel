# Copy to .env (gitignored, chmod 600 on the server) and fill in.
# Every variable the app reads goes through config.settings.Settings,
# prefixed KESTREL_ — see that file for defaults and docstrings.

# --- storage ---
KESTREL_DATA_DIR=data
KESTREL_POSTGRES_DSN=postgresql+psycopg://kestrel:kestrel@localhost:5432/kestrel

# --- Alpaca market data ---
# Free paper-account keys (https://alpaca.markets — sign up, no funding
# needed). NOT a live-trading credential: Phase 0 only calls read-only
# historical-bars endpoints. Never put a live/non-paper key here before
# Phase 7 is explicitly unlocked (SPEC.md Section 0, rule 4).
KESTREL_ALPACA_API_KEY_ID=
KESTREL_ALPACA_API_SECRET_KEY=

# --- misc ---
KESTREL_LOG_LEVEL=INFO

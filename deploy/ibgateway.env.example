# Copy to deploy/ibgateway.env and `chmod 600` it. Read ONLY by the
# ib-gateway container (IBC logs in with these). PAPER credentials only
# until Phase 7 is explicitly unlocked.
TWS_USERID=
TWS_PASSWORD=
# Optional: set to enable VNC inside the container network (no host port
# is published; tunnel with `docker compose exec` / SSH if ever needed).
VNC_SERVER_PASSWORD=
